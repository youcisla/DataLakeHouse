# ============================================================
#  PROJET DATALAKE MÉTÉO — Variables d'environnement
#  TP Big Data : DataLake / DataLakehouse (architecture Bronze→Silver→Gold)
# ============================================================

# ---------- HDFS ----------
HDFS_NAMENODE=namenode
HDFS_WEBHDFS_PORT=9870
HDFS_RPC_PORT=9000
# Quota maximal du Bronze (en Go). Au-delà, le producteur Kafka s'arrête.
BRONZE_QUOTA_GB=10.5
# Cible de volume pour la source batch NOAA (en Go)
NOAA_TARGET_GB=6.6

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
METEO_TOPIC=meteo-stream

# ---------- Open-Meteo (temps réel) ----------
# Villes surveillées par le producteur (JSON)
OPENMETEO_CITIES=[{"city":"Paris","latitude":48.8534,"longitude":2.3488},{"city":"Lyon","latitude":45.764,"longitude":4.8357},{"city":"Marseille","latitude":43.2965,"longitude":5.3698},{"city":"Bordeaux","latitude":44.8378,"longitude":-0.5792},{"city":"Lille","latitude":50.6292,"longitude":3.0573}]
# Fréquence d'interrogation de l'API (secondes)
POLL_INTERVAL_SECONDS=300
# Durée maximale d'exécution du job streaming (secondes)
STREAMING_RUNTIME_SECONDS=3600
# Fréquence des micro-batchs Spark Structured Streaming
STREAMING_TRIGGER_SECONDS=30

# ---------- NOAA (batch) ----------
NOAA_BASE_URL=https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/access/
NOAA_START_YEAR=2022
NOAA_END_YEAR=2025
# Répertoire local de cache pour les téléchargements NOAA
NOAA_CACHE_DIR=/opt/data/noaa

# ---------- Silver / Gold ----------
SILVER_START_DATE=2022-01-01
SILVER_END_DATE=2025-12-31
# Seuils de détection des événements extrêmes (Gold)
THRESHOLD_HEATWAVE_C=35.0
THRESHOLD_HEAVY_RAIN_MM=20.0
THRESHOLD_STRONG_WIND_MS=20.0
THRESHOLD_COLD_SNAP_C=-10.0

# ---------- ML & GenAI ----------
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b
ML_FORECAST_HORIZON_DAYS=1
ML_TRAIN_TEST_SPLIT=0.15

# ---------- Airflow ----------
AIRFLOW_UID=50000
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
AIRFLOW_WEB_PORT=8080
_FERNET_KEY=

# ---------- Jupyter ----------
JUPYTER_TOKEN=meteo

# ---------- Dashboard ----------
STREAMLIT_PORT=8501
