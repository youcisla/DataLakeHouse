# Fins de ligne : LF partout, quoi qu'en dise la config git de la machine.
* text=auto

# Scripts et outils de build : LF obligatoire (bash et make rejettent CRLF).
*.sh        text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.toml      text eol=lf
.env        text eol=lf

# Fichiers binaires : ne jamais les convertir.
*.pdf       binary
*.docx      binary
*.gz        binary
*.joblib    binary
*.parquet   binary
*.pyc       binary
